<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>VoiceHelper</RootNamespace>
    <AssemblyName>VoiceHelper</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- System.Speech's culture-based recognizer lookup needs full ICU/NLS,
         not the trimmed-down invariant globalization mode the default
         template sometimes enables. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Speech" />
  </ItemGroup>

</Project>
